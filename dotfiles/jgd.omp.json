{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "palette": {
    "green": "#8bd5ca",
    "blue": "#8aadf4",
    "yellow": "#eed49f",
    "red": "#ed8796",
    "muted": "#a5adcb",
    "surface": "#24273a",
    "session_bg": "#4f8ee8",
    "path_bg": "#4caf50",
    "git_bg": "#8aadf4",
    "dirty_bg": "#ed8796",
    "tracking_bg": "#4f8ee8"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "path",
          "style": "powerline",
          "foreground": "#202124",
          "background": "p:path_bg",
          "powerline_symbol": "",
          "properties": {
            "style": "agnoster_short",
            "max_depth": 2,
            "folder_icon": "..."
          },
          "template": " {{ .Path }} "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#ffffff",
          "properties": {
            "fetch_status": false,
            "branch_icon": ""
          },
          "template": "\n  {{ .Commit.Subject }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:green",
          "template": " {{ printf \"%c\" 60 }}jkdmyrs{{ printf \"%c\" 62 }}"
        },
        {
          "type": "text",
          "style": "plain",
          "template": "\n"
        },
        {
          "type": "git",
          "style": "diamond",
          "foreground": "#202124",
          "background": "p:git_bg",
          "leading_diamond": "",
          "trailing_diamond": "",
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": false,
            "branch_icon": ""
          },
          "template": " {{ .HEAD }}{{ if gt .Ahead 0 }} ↑{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} ↓{{ .Behind }}{{ end }} "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:dirty_bg",
          "properties": {
            "fetch_status": false,
            "branch_icon": ""
          },
          "template": "{{ if or .Working.Changed .Staging.Changed }} *{{ end }}"
        },
        {
          "type": "text",
          "style": "plain",
          "template": "\n$ "
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:muted",
          "properties": {
            "threshold": 500
          },
          "template": " {{ .FormattedMs }}"
        }
      ]
    }
  ]
}
